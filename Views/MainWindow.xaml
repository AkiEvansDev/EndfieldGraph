<ui:FluentWindow 
    x:Class="EndfieldGraph.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:EndfieldGraph.ViewModels"
    xmlns:local="clr-namespace:EndfieldGraph.Views"
    mc:Ignorable="d"
    Width="1200" 
    Height="800"
    WindowState="Maximized"
    d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=True}"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Icons/icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            PaneDisplayMode="Left"
            IsPaneToggleVisible="False"
            Padding="42 0 42 0"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            MenuItemsSource="{Binding ViewModel.NavigationItems, Mode=OneWay}"
            FooterMenuItemsSource="{Binding ViewModel.NavigationFooter, Mode=OneWay}">
            <ui:NavigationView.Header>
                <Grid
                    Background="Transparent"
                    MouseDown="Navigation_MouseDown">
                    <StackPanel Margin="42 32 42 12">
                        <ui:BreadcrumbBar x:Name="BreadcrumbBar" />
                    </StackPanel>
                </Grid>
            </ui:NavigationView.Header>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.Row="0" Grid.RowSpan="2" />
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</ui:FluentWindow>
