<Page 
    x:Class="EndfieldGraph.Views.Pages.BuildsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:EndfieldGraph.Views.Controls"
    xmlns:helpers="clr-namespace:EndfieldGraph.Views.Helpers"
    xmlns:conv="clr-namespace:EndfieldGraph.Views.Converters"
    xmlns:local="clr-namespace:EndfieldGraph.Views.Pages"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Title="Builds"
    ScrollViewer.CanContentScroll="False"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    d:DataContext="{d:DesignInstance local:BuildsPage, IsDesignTimeCreatable=False}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    MouseDown="OnPageMouseDown">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility"/>
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding ViewModel}" />
    </Page.Resources>

    <ui:Card
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid>
            <TabControl 
                Grid.Row="2"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding ViewModel.Tabs}"
                SelectedItem="{Binding ViewModel.Selected}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ContextMenu>
                                <ContextMenu
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <ui:MenuItem 
                                        Header="Rename"
                                        Command="{Binding Data.RenameTabCommand, Source={StaticResource VmProxy}}"
                                        CommandParameter="{Binding}">
                                        <ui:MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Edit24"/>
                                        </ui:MenuItem.Icon>
                                    </ui:MenuItem>
                                    <ui:MenuItem 
                                        Header="Delete"
                                        Foreground="{DynamicResource PaletteRedBrush}"
                                        Command="{Binding Data.DeleteTabCommand, Source={StaticResource VmProxy}}"
                                        CommandParameter="{Binding}">
                                        <ui:MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Delete24"/>
                                        </ui:MenuItem.Icon>
                                    </ui:MenuItem>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <ui:TextBlock
                                MinWidth="160"
                                Padding="10 4"
                                Height="28"
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                Visibility="{Binding IsRenaming, Converter={StaticResource InverseBooleanToVisibility}}"/>

                            <ui:TextBox
                                Padding="10 4"
                                Height="28"
                                MinWidth="160"
                                Margin="-2 0 2 0"
                                BorderThickness="0 0 1 0"
                                VerticalAlignment="Center"
                                Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibility}}"
                                LostFocus="OnTabRenameBoxLostFocus"
                                KeyDown="OnTabRenameBoxKeyDown"
                                IsVisibleChanged="OnTabRenameBoxIsVisibleChanged"/>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="538"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="320"/>
                            </Grid.RowDefinitions>

                            <ui:Card 
                                Grid.Column="0"
                                Grid.Row="0"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                BorderThickness="0">
                                <ui:TextBlock 
                                    Text="Calculation (coming soon)"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ui:Card>

                            <controls:ResourceGraphView
                                Grid.Row="0"
                                Grid.Column="2"
                                Grid.RowSpan="3"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Layout="{Binding DataContext.ViewModel.GraphLayout, RelativeSource={RelativeSource AncestorType=Page}}"/>

                            <ui:Card
                                Grid.Column="0"
                                Grid.Row="2"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="12"/>
                                    </Grid.RowDefinitions>

                                    <ui:TextBlock VerticalAlignment="Center" Text="Goals:"/>

                                    <ui:Button
                                        Content="Add"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DataContext.ViewModel.AddGoalCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Add24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Count (per min):"/>

                                    <ui:DynamicScrollViewer
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3">
                                        <ItemsControl
                                            ItemsSource="{Binding Goals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0 0 0 6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="300"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <controls:ResourcePicker
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Stretch"
                                                            SelectedId="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            ItemsSource="{Binding DataContext.ViewModel.AllResources, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            TakenItems="{Binding DataContext.ViewModel.Selected.Goals, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                                        <ui:NumberBox 
                                                            Grid.Column="2"
                                                            PlaceholderText="Count"
                                                            Minimum="1"
                                                            Maximum="99"
                                                            Height="35"
                                                            Value="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                                            KeyDown="OnTextBoxKeyDown">
                                                            <ui:NumberBox.Icon>
                                                                <ui:SymbolIcon Symbol="NumberSymbolSquare24"/>
                                                            </ui:NumberBox.Icon>
                                                        </ui:NumberBox>

                                                        <ui:Button
                                                            Grid.Column="4"
                                                            Height="35"
                                                            Foreground="{DynamicResource PaletteRedBrush}"
                                                            Command="{Binding DataContext.ViewModel.RemoveGoalCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Delete24"/>
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ui:DynamicScrollViewer>
                                </Grid>
                            </ui:Card>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            
            <ui:Button 
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Command="{Binding ViewModel.AddTabCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24"/>
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </ui:Card>
</Page>
