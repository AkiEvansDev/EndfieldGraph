<Page 
    x:Class="EndfieldGraph.Views.Pages.BuildsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:EndfieldGraph.Views.Controls"
    xmlns:helpers="clr-namespace:EndfieldGraph.Views.Helpers"
    xmlns:conv="clr-namespace:EndfieldGraph.Views.Converters"
    xmlns:local="clr-namespace:EndfieldGraph.Views.Pages"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Title="Builds"
    ScrollViewer.CanContentScroll="False"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    d:DataContext="{d:DesignInstance local:BuildsPage, IsDesignTimeCreatable=False}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    MouseDown="OnPageMouseDown">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility"/>
        <conv:PerMinConverter x:Key="PerMin"/>
        <conv:CraftsPerMinConverter x:Key="CraftsPerMin"/>
        <conv:ByteArrayToBitmapImageConverter x:Key="BytesToImg"/>
        
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding ViewModel}" />
    </Page.Resources>

    <ui:Card
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid>
            <TabControl 
                Grid.Row="2"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding ViewModel.Tabs}"
                SelectedItem="{Binding ViewModel.Selected}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ContextMenu>
                                <ContextMenu
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <ui:MenuItem 
                                        Header="Rename"
                                        Command="{Binding Data.RenameTabCommand, Source={StaticResource VmProxy}}"
                                        CommandParameter="{Binding}">
                                        <ui:MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Edit24"/>
                                        </ui:MenuItem.Icon>
                                    </ui:MenuItem>
                                    <ui:MenuItem 
                                        Header="Delete"
                                        Foreground="{DynamicResource PaletteRedBrush}"
                                        Command="{Binding Data.DeleteTabCommand, Source={StaticResource VmProxy}}"
                                        CommandParameter="{Binding}">
                                        <ui:MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Delete24"/>
                                        </ui:MenuItem.Icon>
                                    </ui:MenuItem>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <ui:TextBlock
                                MinWidth="160"
                                Padding="10 4"
                                Height="28"
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                Visibility="{Binding IsRenaming, Converter={StaticResource InverseBooleanToVisibility}}"/>

                            <ui:TextBox
                                Padding="10 4"
                                Height="28"
                                MinWidth="160"
                                Margin="-2 0 2 0"
                                BorderThickness="0 0 1 0"
                                VerticalAlignment="Center"
                                Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibility}}"
                                LostFocus="OnTabRenameBoxLostFocus"
                                KeyDown="OnTabRenameBoxKeyDown"
                                IsVisibleChanged="OnTabRenameBoxIsVisibleChanged"/>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="538"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="320"/>
                            </Grid.RowDefinitions>

                            <ui:Card 
                                Grid.Column="0"
                                Grid.Row="0"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="0"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel 
                                        Grid.Row="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                        <ui:TextBlock 
                                            Text="Calculation" 
                                            FontWeight="SemiBold"/>
                                        <ui:TextBlock
                                            Margin="6 0 0 0"
                                            Text="(per minute)"
                                            Appearance="Secondary"/>
                                    </StackPanel>

                                    <ItemsControl 
                                        Grid.Row="2" 
                                        ItemsSource="{Binding DataContext.ViewModel.Calculation.Leaves, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Card
                                                    Margin="0 6 6 0"
                                                    Padding="6 2"
                                                    BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:Image
                                                            Width="16" Height="16"
                                                            CornerRadius="3"
                                                            Margin="0 0 6 0"
                                                            Stretch="Uniform"
                                                            Source="{Binding IconPngBytes, Converter={StaticResource BytesToImg}}"/>
                                                        <ui:TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Name}"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Margin="0 0 6 0"/>
                                                        <ui:TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{Binding NeedPerMin, Converter={StaticResource PerMin}}"/>
                                                    </StackPanel>
                                                </ui:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ui:DynamicScrollViewer 
                                        Grid.Row="4"
                                        VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl 
                                            ItemsSource="{Binding DataContext.ViewModel.Calculation.Rows, RelativeSource={RelativeSource AncestorType=Page}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Card
                                                        Height="100"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Stretch"
                                                        Margin="0 0 0 12"
                                                        VerticalContentAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="12"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="50"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="6"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <ui:Image
                                                                Grid.RowSpan="3"
                                                                Width="64" Height="64"
                                                                CornerRadius="12"
                                                                Margin="-6 -16"
                                                                Stretch="Uniform"
                                                                Source="{Binding IconPngBytes, Converter={StaticResource BytesToImg}}"/>

                                                            <StackPanel
                                                                Grid.Column="2" 
                                                                Grid.Row="0" 
                                                                Orientation="Horizontal" 
                                                                VerticalAlignment="Top">
                                                                <ui:TextBlock 
                                                                    Text="{Binding Name}" 
                                                                    FontWeight="SemiBold"/>

                                                                <ui:Card
                                                                    Margin="6 0 0 0"
                                                                    Padding="6 2 6 0"
                                                                    BorderThickness="0"
                                                                    Visibility="{Binding IsGoal, Converter={StaticResource BooleanToVisibility}}">
                                                                    <ui:TextBlock 
                                                                        Text="Goal"
                                                                        Appearance="Secondary"
                                                                        FontSize="12"/>
                                                                </ui:Card>
                                                            </StackPanel>

                                                            <Grid 
                                                                Grid.Column="2" 
                                                                Grid.Row="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="12"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <controls:ProdConsBar
                                                                    VerticalAlignment="Center"
                                                                    Produced="{Binding ProducedPerMin}"
                                                                    Consumed="{Binding ConsumedPerMin}"/>

                                                                <ui:TextBlock 
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    Appearance="Tertiary"
                                                                    FontSize="12"
                                                                    LineHeight="1">
                                                                    <Run Text="C "/>
                                                                    <Run Text="{Binding ConsumedPerMin, Converter={StaticResource PerMin}}"/>
                                                                    <LineBreak/>
                                                                    <Run Text="P "/>
                                                                    <Run Text="{Binding ProducedPerMin, Converter={StaticResource PerMin}}"/>
                                                                </ui:TextBlock>
                                                            </Grid>

                                                            <StackPanel 
                                                                Grid.Column="4" 
                                                                Grid.RowSpan="3" 
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                                <ui:TextBlock 
                                                                    Appearance="Tertiary"
                                                                    Text="machines"
                                                                    FontSize="12"/>
                                                                <ui:TextBlock 
                                                                    Text="{Binding Machines}" 
                                                                    FontSize="18" 
                                                                    FontWeight="SemiBold"
                                                                    HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ui:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ui:DynamicScrollViewer>
                                </Grid>
                            </ui:Card>

                            <controls:ResourceGraphView
                                Grid.Row="0"
                                Grid.Column="2"
                                Grid.RowSpan="3"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Layout="{Binding DataContext.ViewModel.GraphLayout, RelativeSource={RelativeSource AncestorType=Page}}"/>

                            <ui:Card
                                Grid.Column="0"
                                Grid.Row="2"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="12"/>
                                    </Grid.RowDefinitions>

                                    <ui:TextBlock VerticalAlignment="Center" Text="Goals:"/>

                                    <ui:Button
                                        Content="Add"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DataContext.ViewModel.AddGoalCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Add24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Count:"/>

                                    <ui:DynamicScrollViewer
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3">
                                        <ItemsControl
                                            ItemsSource="{Binding Goals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0 0 0 6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="300"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <controls:ResourcePicker
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Stretch"
                                                            SelectedId="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            ItemsSource="{Binding DataContext.ViewModel.AllResources, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            TakenItems="{Binding DataContext.ViewModel.Selected.Goals, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                                        <ui:NumberBox 
                                                            Grid.Column="2"
                                                            PlaceholderText="Count"
                                                            Minimum="1"
                                                            Maximum="99"
                                                            Height="35"
                                                            Value="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                                            KeyDown="OnTextBoxKeyDown">
                                                            <ui:NumberBox.Icon>
                                                                <ui:SymbolIcon Symbol="NumberSymbolSquare24"/>
                                                            </ui:NumberBox.Icon>
                                                        </ui:NumberBox>

                                                        <ui:Button
                                                            Grid.Column="4"
                                                            Height="35"
                                                            Foreground="{DynamicResource PaletteRedBrush}"
                                                            Command="{Binding DataContext.ViewModel.RemoveGoalCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Delete24"/>
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ui:DynamicScrollViewer>
                                </Grid>
                            </ui:Card>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            
            <ui:Button 
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Command="{Binding ViewModel.AddTabCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24"/>
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </ui:Card>
</Page>
