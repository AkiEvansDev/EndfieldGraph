<Page 
    x:Class="EndfieldGraph.Views.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:EndfieldGraph.Views.Controls"
    xmlns:conv="clr-namespace:EndfieldGraph.Views.Converters"
    xmlns:local="clr-namespace:EndfieldGraph.Views.Pages"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Title="Resources"
    ScrollViewer.CanContentScroll="False"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    d:DataContext="{d:DesignInstance local:ResourcesPage, IsDesignTimeCreatable=False}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    MouseDown="OnPageMouseDown">

    <Page.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Page.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
        </Grid.RowDefinitions>

        <ui:Card 
            Grid.Column="0"
            Grid.RowSpan="3"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                </Grid.RowDefinitions>

                <ui:TextBox
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    PlaceholderText="Search"
                    Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24"/>
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <ui:Button
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Stretch"
                    Command="{Binding ViewModel.ToggleSortCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="TextSortAscending24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.SortAscending}" Value="False">
                                            <Setter Property="Symbol" Value="TextSortDescending24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </ui:Button.Icon>
                </ui:Button>

                <StackPanel 
                    Grid.Row="2"
                    Orientation="Horizontal">
                    <ui:Button
                        Content="Add"
                        Command="{Binding ViewModel.AddResourceCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button 
                        Margin="6 0 0 0"
                        Content="Delete"
                        Foreground="{DynamicResource PaletteRedBrush}"
                        Command="{Binding ViewModel.DeleteSelectedCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <ui:Button
                    Grid.Row="2"
                    Grid.Column="2"
                    VerticalAlignment="Stretch"
                    Click="OnMoreButtonClick">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="MoreHorizontal24"/>
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Flyout
                    x:Name="MoreFlyout"
                    Grid.Row="2"
                    Grid.Column="2"
                    Placement="Bottom">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                        </Grid.RowDefinitions>

                        <ui:Button
                            Grid.Row="0"
                            Content="Import (Replace)"
                            Command="{Binding ViewModel.ImportReplaceCommand}"/>

                        <ui:Button
                            Grid.Row="2"
                            Content="Import (Merge)"
                            Command="{Binding ViewModel.ImportMergeCommand}"/>

                        <ui:Button
                            Grid.Row="4"
                            Content="Export"
                            Command="{Binding ViewModel.ExportCommand}"/>
                    </Grid>
                </ui:Flyout>

                <ui:ListView
                    Grid.Row="4"
                    Grid.ColumnSpan="3"
                    ItemsSource="{Binding ViewModel.ResourcesView}"
                    SelectedItem="{Binding ViewModel.Selected}">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12 6" Orientation="Horizontal">
                                <ui:Image
                                    Width="28" Height="28"
                                    CornerRadius="4"
                                    Margin="0 0 12 0"
                                    Source="{Binding Icon}" Stretch="Uniform"/>
                                <ui:TextBlock 
                                    VerticalAlignment="Center" 
                                    Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </Grid>
        </ui:Card>

        <ui:Card 
            Grid.Column="2"
            VerticalAlignment="Top"
            VerticalContentAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                </Grid.RowDefinitions>

                <StackPanel 
                    Grid.Row="0" 
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal">
                    <ui:Image
                        Width="72" Height="72"
                        CornerRadius="4"
                        Margin="0 0 12 0"
                        Source="{Binding ViewModel.Selected.Icon}" Stretch="Uniform" ClipToBounds="True"/>

                    <ui:Button
                        x:Name="ChangeIcon"
                        Content="Change icon…"
                        Command="{Binding ViewModel.PickIconCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ImageAdd24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <StackPanel
                    Grid.Row="0" 
                    Grid.Column="4"
                    Grid.RowSpan="9"
                    Visibility="{Binding IsEnabled, ElementName=ChangeIcon, Converter={StaticResource BooleanToVisibility}}">
                    <ui:InfoBar
                        Title="Warning"
                        IsClosable="False"
                        Severity="Warning"
                        Message="{Binding ViewModel.GraphWarning}"
                        IsOpen="{Binding IsEnabled, ElementName=ShowGraph, Converter={StaticResource InverseBool}}"/>
                    
                    <ui:HyperlinkButton
                        x:Name="ShowGraph"
                        Content="Show graph"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsEnabled, ElementName=ShowGraph, Converter={StaticResource BooleanToVisibility}}"
                        Command="{Binding ViewModel.ViewGraphCommand}">
                        <ui:HyperlinkButton.Icon>
                            <ui:SymbolIcon Symbol="BranchFork24"/>
                        </ui:HyperlinkButton.Icon>
                    </ui:HyperlinkButton>
                </StackPanel>

                <ui:TextBlock Grid.Row="2" Text="Name:"/>
                <ui:TextBox
                    Grid.Row="4"
                    Grid.ColumnSpan="3"
                    PlaceholderText="Resource name"
                    Text="{Binding ViewModel.Selected.Name, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding ElementName=ChangeIcon, Path=IsEnabled}"
                    KeyDown="OnTextBoxKeyDown"/>

                <ui:TextBlock Grid.Row="6" Text="Output Qty:"/>
                <ui:NumberBox 
                    Grid.Row="8"
                    PlaceholderText="Craft count"
                    Minimum="1"
                    Value="{Binding ViewModel.Selected.OutputQty, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding ElementName=ChangeIcon, Path=IsEnabled}"
                    KeyDown="OnTextBoxKeyDown">
                    <ui:NumberBox.Icon>
                        <ui:SymbolIcon Symbol="NumberSymbolSquare24"/>
                    </ui:NumberBox.Icon>
                </ui:NumberBox>

                <ui:TextBlock Grid.Row="6" Grid.Column="2" Text="Time (sec):"/>
                <ui:NumberBox 
                    Grid.Row="8"
                    Grid.Column="2"
                    PlaceholderText="Craft time"
                    Minimum="1"
                    Maximum="99"
                    Value="{Binding ViewModel.Selected.CraftTimeSec, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding ElementName=ChangeIcon, Path=IsEnabled}"
                    KeyDown="OnTextBoxKeyDown">
                    <ui:NumberBox.Icon>
                        <ui:SymbolIcon Symbol="TimePicker24"/>
                    </ui:NumberBox.Icon>
                </ui:NumberBox>

            </Grid>
        </ui:Card>

        <ui:Card 
            Grid.Column="2"
            Grid.Row="2"
            VerticalAlignment="Top"
            VerticalContentAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="326"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                </Grid.RowDefinitions>

                <ui:TextBlock VerticalAlignment="Center" Text="Components:"/>

                <ui:Button
                    Content="Add"
                    HorizontalAlignment="Right"
                    Command="{Binding ViewModel.AddInputCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24"/>
                    </ui:Button.Icon>
                </ui:Button>

                <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Count:"/>

                <ui:DynamicScrollViewer
                    Grid.Row="2"
                    Grid.ColumnSpan="3">
                    <ItemsControl
                        ItemsSource="{Binding ViewModel.Selected.Inputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 0 0 6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="326"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <controls:ResourcePicker
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        SelectedId="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{Binding DataContext.ViewModel.InputResources, RelativeSource={RelativeSource AncestorType=Page}}"
                                        TakenItems="{Binding DataContext.ViewModel.Selected.Inputs, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                    <ui:NumberBox 
                                        Grid.Column="2"
                                        PlaceholderText="Count"
                                        Minimum="1"
                                        Maximum="99"
                                        Height="35"
                                        Value="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                        KeyDown="OnTextBoxKeyDown">
                                        <ui:NumberBox.Icon>
                                            <ui:SymbolIcon Symbol="NumberSymbolSquare24"/>
                                        </ui:NumberBox.Icon>
                                    </ui:NumberBox>

                                    <ui:Button
                                        Grid.Column="4"
                                        Height="35"
                                        Foreground="{DynamicResource PaletteRedBrush}"
                                        Command="{Binding DataContext.ViewModel.RemoveInputCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Delete24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <ui:HyperlinkButton
                                        Grid.Column="6"
                                        Height="35"
                                        Content="Open"
                                        Command="{Binding DataContext.ViewModel.ShowInputCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}">
                                        <ui:HyperlinkButton.Icon>
                                            <ui:SymbolIcon Symbol="Box24"/>
                                        </ui:HyperlinkButton.Icon>
                                    </ui:HyperlinkButton>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:DynamicScrollViewer>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
